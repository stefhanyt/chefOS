# ──────────────────────────────────────────────────────
# ChefOS — Local environment variables
# ──────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored — never commit real credentials.
#
# Where to find these values:
#   1. Go to https://supabase.com/dashboard
#   2. Open your project → Project Settings → API
#   3. Copy "Project URL" → NEXT_PUBLIC_SUPABASE_URL
#   4. Copy "anon / public" key → NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# Without these the app runs in mock-data mode (read-only demo data).
# ──────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ──────────────────────────────────────────────────────
# Anthropic API key — required for Photo Scan (AI item detection)
# Get yours at https://console.anthropic.com/settings/api-keys
# Without this key the Photo Scan page shows a "not configured" error;
# all other features work normally.
# ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
